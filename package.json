{
  "name": "juce-ui",
  "version": "0.4.0",
  "private": false,
  "description": "React UI kit for Juce: primitives, AI patterns, blocks and pages",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "ui-kit",
    "storybook",
    "design-system",
    "ai-elements"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KirillYuzh/Juce.git"
  },
  "homepage": "https://github.com/KirillYuzh/Juce#readme",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/juce-ui.js",
  "module": "./dist/juce-ui.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/juce-ui.js"
    },
    "./styles.css": "./dist/juce-ui.css",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "drive": "node scripts/drive.mjs",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "lint": "eslint .",
    "lint:rules": "ast-grep scan --config sgconfig.yml --error src",
    "rules:test": "node scripts/test-rules.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:update": "node scripts/run-tests.mjs --update",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "check": "npm run typecheck && npm run lint && npm run lint:rules && npm run rules:test && npm run test",
    "prepare": "npm run build:lib",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.51.3",
    "@eslint/js": "^9.39.5",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.3",
    "globals": "^17.14.0",
    "jsdom": "^28.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
