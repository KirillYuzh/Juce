{
  "name": "juce-ui",
  "version": "0.5.0",
  "private": false,
  "description": "React UI kit for Juce: primitives, AI patterns, blocks and pages",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "ui-kit",
    "storybook",
    "design-system",
    "ai-elements"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KirillYuzh/Juce.git"
  },
  "homepage": "https://github.com/KirillYuzh/Juce#readme",
  "files": [
    "dist",
    "LICENSES",
    "THIRD-PARTY-NOTICES.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/juce-ui.js",
  "module": "./dist/juce-ui.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/juce-ui.js",
      "default": "./dist/juce-ui.js"
    },
    "./styles.css": {
      "default": "./dist/juce-ui.css"
    },
    "./styles-core.css": {
      "default": "./dist/juce-ui-core.css"
    },
    "./fonts.css": {
      "default": "./dist/juce-ui-fonts.css"
    },
    "./reset.css": {
      "default": "./dist/reset.css"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "scripts": {
    "dev": "vite",
    "drive": "node scripts/drive.mjs",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json && node scripts/fix-declarations.mjs && node scripts/copy-reset.mjs && node scripts/split-fonts.mjs",
    "lint": "eslint .",
    "lint:rules": "ast-grep scan --config sgconfig.yml --error src",
    "lint:css": "node scripts/check-css.mjs && node scripts/check-css.mjs --test",
    "check:pack": "node scripts/check-pack.mjs",
    "spec:validate": "openspec validate --all --strict --no-interactive",
    "rules:test": "node scripts/test-rules.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:update": "node scripts/run-tests.mjs --update",
    "test:bombadil": "node scripts/bombadil.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "check": "npm run typecheck && npm run lint && npm run lint:rules && npm run rules:test && npm run lint:css && npm run build:lib && npm run check:pack && npm run test && npm run spec:validate",
    "prepare": "npm run build:lib",
    "prepublishOnly": "npm run check",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@antithesishq/bombadil": "^0.8.0",
    "@antv/x6": "^3.1.8",
    "@ast-grep/cli": "^0.51.3",
    "@eslint/js": "^9.39.5",
    "@fission-ai/openspec": "^2.1.1",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@joint/core": "^4.3.4",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/culori": "^4.0.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@xyflow/react": "^13.0.3",
    "culori": "^4.0.2",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.3",
    "globals": "^17.14.0",
    "jsdom": "^28.1.0",
    "motion": "^14.14.0",
    "ogl": "^1.0.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vgpu": "^0.3.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
